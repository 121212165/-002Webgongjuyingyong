{
  "name": "deep-reader",
  "version": "1.0.0",
  "description": "深度阅读器 - 支持多格式文档阅读和智能笔记管理",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "test": "jest"
  },
  "keywords": [
    "reader",
    "pdf",
    "epub",
    "notes",
    "git",
    "electron"
  ],
  "author": "Deep Reader Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.0",
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "epubjs": "^0.3.93",
    "express": "^4.18.0",
    "isomorphic-git": "^1.25.0",
    "multer": "^1.4.4",
    "nedb": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0"
  },
  "build": {
    "appId": "com.deepreader.app",
    "productName": "深度阅读器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "node_modules/electron/**/*"
    ]
  }
}
