{
  "manifest_version": 3,
  "name": "灵感挖掘机",
  "version": "1.0.0",
  "description": "个人创意需求分析工具 - 可视化思维导图 + AI辅助",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "options_page": "options.html",
  "host_permissions": []
}
