{
  "manifest_version": 3,
  "name": "灵感挖掘机 - 触摸屏版",
  "version": "1.0.0",
  "description": "个人创意需求分析工具 - 触摸屏优化版本",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "storage": {
    "managed_schema": "storage-schema.json"
  }
}
